NODE_ENV=development

PORT=3001

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=notes_app

# Para producción: URL de conexión completa (ej: Aiven, Railway, Render)
# DATABASE_URL=postgresql://user:pass@host:port/dbname

# Clave para proteger todos los endpoints de la API.
# Debe coincidir con VITE_API_KEY del frontend.
API_KEY=notes-studio-demo-key
